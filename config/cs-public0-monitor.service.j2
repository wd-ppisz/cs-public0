[Unit]
Description=Bridge inspection telemetry
After=cs-public0.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/cs-public0 monitor
{% if cs_public0_nfq_gso %}
ExecStart=/usr/local/libexec/cs-public0-gso --unit cs-public0.service --binary-sha256 {{ cs_public0_nfq_gso_binary_sha256 }} --queue {{ cs_public0_queue }} --host %H --metrics-file {{ cs_public0_metrics_file | dirname }}/cs_public0_gso.prom
{% endif %}
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths={{ cs_public0_state_dir }} {{ cs_public0_runtime_dir }} {{ cs_public0_metrics_file | dirname }}
