--- /dev/null
+++ b/src/source-nfq-copy.h
@@ -0,0 +1,80 @@
+/* Kandydat laboratoryjny: odczyt publicznego formatu netlink, bez nfq_data ABI. */
+#ifndef WD_NFQ_COPY_CHECK_H
+#define WD_NFQ_COPY_CHECK_H
+#include <arpa/inet.h>
+#include <linux/netlink.h>
+#include <linux/netfilter/nfnetlink.h>
+#include <linux/netfilter/nfnetlink_queue.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+
+typedef struct WDNFQCopy_ {
+    uint32_t payload_len;
+    uint32_t original_len;
+} WDNFQCopy;
+
+/* 0: pełna kopia, 1: świadomie skrócona, -1: niespójny komunikat.
+ * msg_offset wskazuje nagłówek nlmsghdr, także w wielokomunikatowym recv.
+ * memcpy unika niealigned odczytów. Nie czytamy poza faktycznym recv. */
+static inline int WDNFQCopyCheck(const void *buffer, size_t received,
+        size_t msg_offset, WDNFQCopy *out)
+{
+    const unsigned char *bytes = buffer;
+    struct nlmsghdr msg;
+    size_t cursor = 0;
+    memset(out, 0, sizeof(*out));
+    while (cursor <= msg_offset) {
+        if (cursor > received || received - cursor < sizeof(msg))
+            return -1;
+        memcpy(&msg, bytes + cursor, sizeof(msg));
+        if (msg.nlmsg_len < NLMSG_HDRLEN || msg.nlmsg_len > received - cursor)
+            return -1;
+        if (cursor == msg_offset)
+            break;
+        size_t step = NLMSG_ALIGN((size_t)msg.nlmsg_len);
+        if (step > msg_offset - cursor)
+            return -1;
+        cursor += step;
+    }
+    if (cursor != msg_offset || msg.nlmsg_len < NLMSG_HDRLEN + sizeof(struct nfgenmsg) ||
+            msg.nlmsg_type != ((NFNL_SUBSYS_QUEUE << 8) | NFQNL_MSG_PACKET))
+        return -1;
+    size_t end = cursor + msg.nlmsg_len;
+    cursor += NLMSG_HDRLEN + sizeof(struct nfgenmsg);
+    int payload_seen = 0, cap_seen = 0;
+    while (cursor < end) {
+        struct nlattr attr;
+        if (end - cursor < sizeof(attr))
+            return -1;
+        memcpy(&attr, bytes + cursor, sizeof(attr));
+        if (attr.nla_len < NLA_HDRLEN || attr.nla_len > end - cursor)
+            return -1;
+        size_t length = attr.nla_len - NLA_HDRLEN;
+        unsigned int type = attr.nla_type & NLA_TYPE_MASK;
+        if (type == NFQA_PAYLOAD) {
+            if (payload_seen++)
+                return -1;
+            out->payload_len = (uint32_t)length;
+        } else if (type == NFQA_CAP_LEN) {
+            uint32_t value;
+            if (cap_seen++ || length != sizeof(value))
+                return -1;
+            memcpy(&value, bytes + cursor + NLA_HDRLEN, sizeof(value));
+            out->original_len = ntohl(value);
+        }
+        size_t step = NLA_ALIGN((size_t)attr.nla_len);
+        /* Kernel może zakończyć wiadomość samym payloadem ostatniego
+         * atrybutu, bez pełnego paddingu. nla_len jest już sprawdzone;
+         * brakujących bajtów paddingu nie odczytujemy. */
+        cursor = step > end - cursor ? end : cursor + step;
+    }
+    if (!payload_seen || out->payload_len == 0)
+        return -1;
+    if (!cap_seen)
+        out->original_len = out->payload_len;
+    if (out->original_len < out->payload_len)
+        return -1;
+    return out->original_len != out->payload_len;
+}
+#endif
